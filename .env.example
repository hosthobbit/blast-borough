# Copy to .env and adjust. Nothing here is secret.

# Client (read at build time by Vite): where the online multiplayer server lives.
# Leave unset to use ws(s)://<same host as the page>:8787.
# VITE_SERVER_URL=wss://blast.example.com

# Server
PORT=8787
# Comma-separated list of page origins allowed to connect (empty = allow any).
ALLOWED_ORIGINS=
MAX_ROOMS=200
