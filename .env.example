# Copy to .env and adjust. Nothing here is secret.

# Game (read at build time by Vite)
# Peer-to-peer online rooms find each other through this script (default shown):
# VITE_SIGNAL_URL=https://hosthobbit.com/games-api/blast-signal.php
# Set this instead to use the optional dedicated Node server for online play:
# VITE_SERVER_URL=wss://blast.example.com

# Optional dedicated server
PORT=8787
# Comma-separated list of page origins allowed to connect (empty = allow any).
ALLOWED_ORIGINS=
MAX_ROOMS=200
