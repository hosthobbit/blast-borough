{
  "name": "blast-borough",
  "version": "1.0.0",
  "private": true,
  "description": "Blast Borough: a grid-based bomb battle in a neighbourhood at dusk. Solo vs bots, local and online multiplayer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start:server": "node dist-server/server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
